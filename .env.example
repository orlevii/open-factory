DATABASE_URL=postgres://postgres:password@localhost:5432/factory
# Generate with: openssl rand -base64 32
FACTORY_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
# FACTORY_HOME=~/open-factory
# PUBLIC_URL=http://localhost:3000
# PORT=3000
# HOST=127.0.0.1
# LOG_LEVEL=info
# Vite dev server origin, trusted outside production only
# DEV_WEB_ORIGIN=http://localhost:5173
# Set on servers: JSON logs, and stops trusting DEV_WEB_ORIGIN
# NODE_ENV=production
# Path to Claude Code if it isn't on PATH
# FACTORY_CLAUDE_BIN=claude
# Where host skills named in templates live
# FACTORY_HOST_SKILLS_DIR=~/.claude/skills
# Most agents running at once; the rest wait in the queue (minimum 1)
# FACTORY_MAX_RUNNING_AGENTS=8
# Allow agents to run directly on the host instead of in Docker. Development only.
# Development setting: FACTORY_ALLOW_LOCAL_RUNTIME=true
# FACTORY_ALLOW_LOCAL_RUNTIME=false
# Container image for Docker agents
# Development setting: FACTORY_DEFAULT_IMAGE=open-factory-base:dev
# FACTORY_DEFAULT_IMAGE=ghcr.io/orlevii/open-factory/base:latest
# Claude Code path inside the container image
# FACTORY_DOCKER_CLAUDE_BIN=claude
# The bundled CLI mounted into containers (default: apps/cli/dist/open-factory.js in the repo)
# FACTORY_CLI_BUNDLE=
# Port of the agent listener, the separate surface agents call for the factory MCP (default PORT + 1)
# FACTORY_AGENT_PORT=3001
# Comma-separated IP addresses the agent listener binds; replaces the default list (loopback, plus the Docker
# bridge gateway on Linux). Other containers on the bridge can reach it; the per-process agent token protects it.
# 0.0.0.0 or :: binds every interface: then the token is the only protection. With FACTORY_ALLOW_LOCAL_RUNTIME=true
# the list must include 127.0.0.1 (local agents call the factory there).
# FACTORY_AGENT_HOST=127.0.0.1,172.17.0.1
# How containers reach the agent listener (default uses FACTORY_AGENT_PORT, not PORT).
# Upgrading: if you set this to the human port (3000) before, move it to the agent port or unset it.
# FACTORY_AGENT_URL=http://host.docker.internal:3001
# Seconds a report's updates wait for an idle manager before waking it (0 = at once, at most 86400)
# FACTORY_MEMBER_UPDATE_DEBOUNCE_SECONDS=30
# Max spawns per spawner per rolling hour; the error tells agents to ask the humans.
# FACTORY_MAX_SPAWNS_PER_HOUR=20
