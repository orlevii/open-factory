{
  "name": "open-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compose": "docker compose -f docker-compose.dev.yml",
    "dev": "pnpm --parallel --filter @open-factory/server --filter @open-factory/web dev",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "smoke:harness": "node --env-file-if-exists=.env --import tsx apps/server/scripts/smoke-harness.ts",
    "smoke:workspace": "node --env-file-if-exists=.env --import tsx apps/server/scripts/smoke-workspace.ts",
    "smoke:docker": "node --env-file-if-exists=.env --import tsx apps/server/scripts/smoke-docker.ts",
    "db:generate": "pnpm --filter @open-factory/db generate"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
