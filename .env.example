DATABASE_URL=postgres://postgres:password@localhost:5432/factory
# Generate with: openssl rand -base64 32
FACTORY_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
# FACTORY_HOME=~/open-factory
# PUBLIC_URL=http://localhost:3000
# PORT=3000
# HOST=127.0.0.1
# LOG_LEVEL=info
# Vite dev server origin, trusted outside production only
# DEV_WEB_ORIGIN=http://localhost:5173
# Set on servers: JSON logs, and stops trusting DEV_WEB_ORIGIN
# NODE_ENV=production
# Path to Claude Code if it isn't on PATH
# FACTORY_CLAUDE_BIN=claude
# Where host skills named in templates live
# FACTORY_HOST_SKILLS_DIR=~/.claude/skills
# Most agents running at once; the rest wait in the queue (minimum 1)
# FACTORY_MAX_RUNNING_AGENTS=8
# Allow agents to run directly on the host instead of in Docker. Development only.
# Development setting: FACTORY_ALLOW_LOCAL_RUNTIME=true
# FACTORY_ALLOW_LOCAL_RUNTIME=false
# Container image for Docker agents
# Development setting: FACTORY_DEFAULT_IMAGE=open-factory-base:dev
# FACTORY_DEFAULT_IMAGE=ghcr.io/orlevii/open-factory/base:latest
# Claude Code path inside the container image
# FACTORY_DOCKER_CLAUDE_BIN=claude
# The bundled CLI mounted into containers (default: apps/cli/dist/open-factory.js in the repo)
# FACTORY_CLI_BUNDLE=
# How containers reach this server (default uses PORT)
# FACTORY_AGENT_URL=http://host.docker.internal:3000
